<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700;800&family=JetBrains+Mono:wght@400;600&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css" />
  <title><%= slug %> - Posty</title>
</head>
<body>
  <main class="wrap">
    <section class="panel">
      <header class="hero">
        <h1><%= slug.replace(/-/g, ' ') %></h1>
        <a class="button-ghost" href="/">Back to posts</a>
      </header>
      <article>
        <%- content %>
      </article>
    </section>
  </main>
</body>
</html>